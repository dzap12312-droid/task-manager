{
  "name": "task-manager",
  "productName": "업무관리",
  "version": "1.3.0",
  "description": "개인 업무 체크리스트 데스크톱 프로그램",
  "main": "main.js",
  "private": true,
  "author": "dzap12312-droid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dzap12312-droid/task-manager.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "dist": "electron-builder --publish never",
    "screenshots": "node scripts/screenshots.js"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "@playwright/test": "1.63.0"
  },
  "build": {
    "appId": "com.taeyeon.taskmanager",
    "productName": "업무관리",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "업무관리",
      "deleteAppDataOnUninstall": false,
      "artifactName": "TaskManager-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "TaskManager-${version}-Portable.${ext}"
    },
    "publish": null
  }
}
